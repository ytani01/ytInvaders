---

---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>ytInvaders</title>
	</head>
	<body>
		<main class="game">
			<div class="hud">
				<span>SCORE <b id="hud-score">0</b></span>
				<span>HI <b id="hud-hi">0</b></span>
				<span>WAVE <b id="hud-wave">1</b></span>
				<span>LIVES <b id="hud-lives">3</b></span>
			</div>
			<canvas id="screen" width="480" height="640" aria-label="ゲーム画面"></canvas>
			<div class="touch">
				<div id="lever" class="lever" role="group" aria-label="左右移動のレバー">
					<span class="track" aria-hidden="true"><span>◀</span><span>▶</span></span>
					<span id="lever-knob" class="lever-knob"></span>
				</div>
				<button id="btn-fire" type="button" aria-label="射撃" class="fire">FIRE</button>
			</div>
		</main>

		<script>
			import { startGame } from '../game/game.ts';

			const $ = (id: string): HTMLElement => {
				const el = document.getElementById(id);
				if (!el) throw new Error(`#${id} が無い`);
				return el;
			};

			startGame(
				$('screen') as HTMLCanvasElement,
				{ score: $('hud-score'), hi: $('hud-hi'), lives: $('hud-lives'), wave: $('hud-wave') },
				{ lever: $('lever'), leverKnob: $('lever-knob'), fire: $('btn-fire') },
			);
		</script>

		<style is:global>
			html,
			body {
				margin: 0;
				height: 100%;
				background: #05010f;
				color: #cfe8ff;
				overflow: hidden;
				overscroll-behavior: none;
				font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
			}
		</style>

		<style>
			.game {
				/* 論理解像度 480x640 の比率を保ったまま、画面に収まる最大の大きさにする */
				--touch-h: 0rem;
				/* ヘッダは 2 行で、文字は幅の 0.065 倍、高さは 2.6 行分（幅の 0.169 倍）。
				   高さが幅で決まるので、w = (高さ - 操作欄 - 0.169w) * 0.75 を w について解いた式にする（TODO-006） */
				--w: min(100vw, calc((100dvh - var(--touch-h)) * 0.75 / 1.12675));
				--hud-h: calc(var(--w) * 0.169);
				width: var(--w);
				margin: 0 auto;
				display: flex;
				flex-direction: column;
				align-items: stretch;
				height: 100dvh;
				justify-content: center;
				box-sizing: border-box;
			}

			.hud {
				height: var(--hud-h);
				/* 2×2 に並べる（SCORE・HI / WAVE・LIVES） */
				display: grid;
				grid-template-columns: auto auto;
				justify-content: space-between;
				align-content: center;
				column-gap: 1em;
				padding: 0 0.5rem;
				font-size: calc(var(--w) * 0.065);
				line-height: 1.2;
				letter-spacing: 0.08em;
				color: #7fdcff;
				text-shadow: 0 0 6px #00e5ff;
			}

			.hud span:nth-child(even) {
				justify-self: end;
			}

			.hud b {
				color: #fff;
				text-shadow: 0 0 8px #ff2bd6;
			}

			canvas {
				display: block;
				width: var(--w);
				height: calc(var(--w) * 4 / 3);
				border: 1px solid #2a1650;
				box-shadow: 0 0 24px #3a0d6a88, inset 0 0 24px #3a0d6a55;
				box-sizing: border-box;
				touch-action: none;
			}

			.touch {
				display: none;
				height: var(--touch-h);
				gap: 0.5rem;
				padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom, 0px));
				box-sizing: border-box;
			}

			.touch > * {
				flex: 1;
				touch-action: none;
				user-select: none;
				-webkit-user-select: none;
				-webkit-touch-callout: none;
			}

			.touch button {
				font: inherit;
				font-size: 1.4rem;
				color: #00e5ff;
				background: #0c0420;
				border: 2px solid #00e5ff;
				border-radius: 12px;
				box-shadow: 0 0 12px #00e5ff66;
			}

			.touch .fire {
				color: #ff2bd6;
				border-color: #ff2bd6;
				box-shadow: 0 0 12px #ff2bd666;
			}

			.touch .fire:active {
				background: #ff2bd633;
			}

			/* 左半分がレバー。真ん中で止まり、左右の端へ寄せるほど速い */
			.lever {
				position: relative;
				overflow: hidden;
				border: 2px solid #00e5ff55;
				border-radius: 12px;
				background: #0c0420;
			}

			/* レバーの溝。つまみが欄の端に着く所が全速（game.ts の moveLever） */
			.lever .track {
				position: absolute;
				left: 0.5rem;
				right: 0.5rem;
				top: 50%;
				height: 4px;
				translate: 0 -50%;
				background: linear-gradient(90deg, #00e5ff, #00e5ff22 45%, #00e5ff22 55%, #00e5ff);
				border-radius: 2px;
			}

			.lever .track span {
				position: absolute;
				top: 50%;
				translate: 0 -50%;
				font-size: 1rem;
				color: #00e5ffaa;
			}

			.lever .track span:first-child {
				left: 0.25rem;
			}

			.lever .track span:last-child {
				right: 0.25rem;
			}

			.lever-knob {
				position: absolute;
				left: 50%;
				top: 50%;
				height: min(4.5rem, 60%);
				aspect-ratio: 1;
				translate: -50% -50%;
				border-radius: 50%;
				background: #00e5ff33;
				border: 2px solid #00e5ff;
				box-shadow: 0 0 12px #00e5ff88;
				box-sizing: border-box;
				pointer-events: none;
			}

			.lever.active .lever-knob {
				background: #00e5ff66;
				box-shadow: 0 0 18px #00e5ff;
			}

			/* タッチできる端末では画面下に操作欄（左がレバー、右が FIRE）を出す（主な入力がマウスでも、タッチ画面があれば出す） */
			@media (any-pointer: coarse) {
				.game {
					/* 画面の高さの 25%。タッチ画面付きの PC で大きくなりすぎないよう上限を付ける */
					--touch-h: calc(min(25dvh, 12rem) + env(safe-area-inset-bottom, 0px));
				}
				.touch {
					display: flex;
				}
			}
		</style>
	</body>
</html>
